{
  "name": "runtime-shell",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "docker:compose:sync": "bun scripts/sync-docker-compose-workers.ts",
    "docker:up": "bun run docker:compose:sync && docker compose -f docker-compose.yml up -d --build",
    "dev": "bun --watch server/src/index.ts",
    "start": "bun server/src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:scripts": "bunx tsc --noEmit -p tsconfig.scripts.json",
    "db:migrate": "bun server/src/db/migrate.ts",
    "e2e:smoke": "bun scripts/e2e-smoke.ts",
    "e2e:question": "bun scripts/e2e-question-form.ts",
    "e2e:scope": "bun scripts/e2e-scope-boundary.ts",
    "e2e:access": "bun scripts/e2e-access-matrix.ts",
    "e2e:share": "bun scripts/e2e-workspace-share.ts",
    "e2e:multi-worker-users": "bun scripts/e2e-multi-worker-users.ts",
    "e2e:settings-impact": "bun scripts/e2e-settings-impact.ts",
    "e2e:web-history": "node scripts/e2e-web-history-capabilities.mjs",
    "e2e:web-mobile": "node scripts/e2e-web-mobile.mjs",
    "e2e:web-slow": "node scripts/e2e-web-slow-network.mjs",
    "e2e:web-list-churn": "node scripts/e2e-web-list-churn.mjs",
    "e2e:web-streaming": "node scripts/e2e-web-streaming.mjs",
    "e2e:web-streaming-soak": "node scripts/e2e-web-streaming-soak.mjs",
    "e2e:worker-routing": "bun scripts/e2e-worker-routing.ts",
    "e2e:settings-governance": "bun scripts/e2e-settings-governance.ts",
    "e2e:config-history": "bun scripts/e2e-config-history-and-scope.ts",
    "e2e:skill": "bun scripts/e2e-skill-management.ts",
    "e2e:governance": "bun scripts/e2e-runtime-governance-soak.ts",
    "e2e:concurrency": "bun scripts/e2e-concurrency.ts",
    "e2e:web-regression": "bun scripts/e2e-web-regression.ts",
    "e2e:web-plan": "bun scripts/e2e-web-regression.ts --plan-only",
    "e2e:web-conversation": "node scripts/e2e-web-conversation-flows.mjs",
    "e2e:web": "node scripts/e2e-web-ui.mjs",
    "e2e:web-skill": "node scripts/e2e-web-skill-management.mjs",
    "e2e:web-boundary": "node scripts/e2e-web-boundary.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "extract-zip": "^2.0.1",
    "hono": "^4.10.7",
    "jsonc-parser": "^3.3.1",
    "mysql2": "^3.14.4",
    "postgres": "^3.4.7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "playwright": "^1.54.2",
    "typescript": "^5.8.2"
  }
}
