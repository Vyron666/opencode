{
  "name": "runtime-shell",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch server/src/index.ts",
    "start": "bun server/src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "db:migrate": "bun server/src/db/migrate.ts",
    "e2e:smoke": "bun scripts/e2e-smoke.ts",
    "e2e:scope": "bun scripts/e2e-scope-boundary.ts",
    "e2e:share": "bun scripts/e2e-workspace-share.ts",
    "e2e:web": "node scripts/e2e-web-ui.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.21.0",
    "hono": "^4.10.7",
    "jsonc-parser": "^3.3.1",
    "mysql2": "^3.14.4",
    "postgres": "^3.4.7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "playwright": "^1.54.2",
    "typescript": "^5.8.2"
  }
}
