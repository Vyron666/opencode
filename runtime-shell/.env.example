RUNTIME_SHELL_HOST=0.0.0.0
RUNTIME_SHELL_PORT=3000
RUNTIME_SHELL_ADMIN_USERNAME=admin
RUNTIME_SHELL_ADMIN_PASSWORD=change-me
RUNTIME_SHELL_SESSION_COOKIE=runtime_shell_session
RUNTIME_SHELL_SESSION_SECRET=change-me
RUNTIME_SHELL_DATA_FILE=./data/runtime-shell.json
RUNTIME_SHELL_DB_DIALECT=postgres
RUNTIME_SHELL_DB_URL=postgres://postgres:change-me@127.0.0.1:5432/runtime_shell
RUNTIME_SHELL_DB_SSL_MODE=disable
RUNTIME_SHELL_DB_SSL_CA_FILE=
RUNTIME_SHELL_DB_CONNECT_TIMEOUT_SECONDS=5
RUNTIME_SHELL_DB_CONNECT_MAX_ATTEMPTS=20
RUNTIME_SHELL_DB_CONNECT_RETRY_DELAY_MS=1000
OPENCODE_BASE_URL=http://opencode-worker:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
OPENCODE_ACP_NEXT=0
RUNTIME_SHELL_SANDBOX_BACKEND=local-process
RUNTIME_SHELL_SANDBOX_IMAGE=opencode-local:latest
RUNTIME_SHELL_SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
# Local verification can use bridge for unrestricted outbound model/MCP/Git/package access.
# Production should route outbound traffic through an egress proxy or a network policy allowlist.
RUNTIME_SHELL_SANDBOX_NETWORK_MODE=runtime-shell_default
RUNTIME_SHELL_SANDBOX_USER=1000:1000
RUNTIME_SHELL_SANDBOX_WORKSPACE_HOST_ROOT=
RUNTIME_SHELL_SANDBOX_SECCOMP_PROFILE=
RUNTIME_SHELL_SANDBOX_APPARMOR_PROFILE=
